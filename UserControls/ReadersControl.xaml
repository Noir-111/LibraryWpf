<UserControl x:Class="LibraryWpf.UserControls.ReadersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="DgReaders" Grid.Column="0" Margin="5"
                  AutoGenerateColumns="False"
                  SelectionChanged="DgReaders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="TbName"/>

            <TextBlock Text="Телефон"/>
            <TextBox x:Name="TbPhone"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить" Click="BtnAdd_Click"/>
                <Button Content="Изменить" Click="BtnEdit_Click"/>
                <Button Content="Удалить" Click="BtnDelete_Click"/>
            </StackPanel>

            <Button Content="Очистить" Click="BtnClear_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
