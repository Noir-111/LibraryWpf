<UserControl x:Class="LibraryWpf.UserControls.ReturnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DgLoans" Margin="5" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Книга" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Читатель" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Принять возврат"
                HorizontalAlignment="Left" Margin="5"
                Height="35"
                Click="BtnReturn_Click"/>
    </Grid>
</UserControl>

