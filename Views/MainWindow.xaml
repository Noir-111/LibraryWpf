<Window x:Class="LibraryWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:LibraryWpf.UserControls"
        Title="Библиотека" Height="520" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <TabControl SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Книги">
                <uc:BooksControl x:Name="BooksUc"/>
            </TabItem>

            <TabItem Header="Читатели">
                <uc:ReadersControl x:Name="ReadersUc"/>
            </TabItem>

            <TabItem Header="Выдача">
                <uc:IssueControl x:Name="IssueUc"/>
            </TabItem>

            <TabItem Header="Возврат">
                <uc:ReturnControl x:Name="ReturnUc"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
